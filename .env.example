# GEMINI_API_KEY: Optional server-side key (not required for BHAVIQ deterministic retail & market operations).
GEMINI_API_KEY=""

# APP_URL: Public URL where BHAVIQ is hosted.
APP_URL="http://localhost:3000"

# DATA_GOV_IN_API_KEY: Official Open Government Data (data.gov.in) API key for AGMARKNET daily mandi commodity prices.
# Obtain a free key at https://data.gov.in/ (resource 9ef84268-d588-465a-a308-a864a43d0070).
# Kept strictly server-side; never exposed to browser clients.
DATA_GOV_IN_API_KEY=""

# BHAVIQ_DB_PATH: Optional custom path for local SQLite persistence (defaults to ./data/bhaviq.db).
BHAVIQ_DB_PATH="./data/bhaviq.db"

# Optional Supabase Auth & PostgreSQL configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional direct Google OAuth (fallback when using server-side Google OAuth without Supabase)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
